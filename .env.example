# Local-only defaults. Do not put credentials or tokens in this file.
APP_ENV=development
LOG_LEVEL=debug
MAX_IMAGE_SIZE_BYTES=5242880
AUTH_MODE=demo
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://foundly-frontend-380030254399.s3-website-us-east-1.amazonaws.com
REPORT_REPOSITORY=in-memory
IMAGE_STORAGE=local
IMAGE_URL_TTL_SECONDS=300
# S3 image mode is opt-in and requires a separate private bucket. Never use
# the public static-website bucket for image uploads.
# IMAGE_STORAGE=s3
# FOUNDLY_IMAGE_BUCKET=foundly-private-images-example
# FOUNDLY_IMAGE_PREFIX=report-images
# DynamoDB mode is opt-in only. Set REPORT_REPOSITORY=dynamodb only after
# the table, indexes, permissions, and AWS region have been separately approved.
# AWS_REGION=us-east-1
# FOUNDLY_REPORTS_TABLE=FoundlyReports
